.seal *{fill:none;stroke:var(--bronze);stroke-linecap:round;stroke-linejoin:round}
.seal .grid-l{stroke-width:1.2;opacity:.5}
.seal .frame{stroke-width:2}
.seal .tick{stroke-width:4.5;stroke:var(--ink)}
.d{stroke-dasharray:1;stroke-dashoffset:1;animation:draw .9s cubic-bezier(.6,.1,.2,1) forwards}
.d1{animation-delay:.1s}.d2{animation-delay:.35s}.d3{animation-delay:.85s;animation-duration:.55s}
@keyframes draw{to{stroke-dashoffset:0}}

h1,h2{font-family:var(--serif);font-weight:600;color:var(--ink);letter-spacing:-.005em}
